{% comment %}
  RUG ROOM — SHOP BY COLLECTION  (Fotakis-style range grid)
  Install: Customize → Home page → Add section → Custom Liquid → paste → Save.
  Place it directly under the hero.

  The grid builds itself from your range collections — each tile pulls the first
  product's image from that collection automatically. Empty collections are
  skipped, so it's safe to install before the tagged CSV re-import; tiles appear
  as the collections fill.
{% endcomment %}

{%- assign range_handles = "vestige-collection,tokyo-collection,cambridge-collection,alaska-collection,antique-collection,al-fresco-collection,hydrapure-collection,iconic-collection,lineo-collection,revival-collection,masawi-collection,valencia-collection,verve-collection,finesse-collection,dreamscapes-collection,playroom-collection,jute-collection,star-silkie-collection,flokati-collection" | split: "," -%}

<section class="rr-ranges">
  <div class="rr-ranges__head">
    <p class="rr-ranges__kicker">The Rug Room ranges</p>
    <h2 class="rr-ranges__title">SHOP BY COLLECTION</h2>
    <p class="rr-ranges__sub">Every range, one page each. Pick a look, then Fit-Check the size before you buy.</p>
  </div>

  <div class="rr-ranges__grid">
    {%- for h in range_handles -%}
      {%- assign c = collections[h] -%}
      {%- if c != blank and c.products.size > 0 -%}
        {%- assign img = c.image | default: c.products.first.featured_image -%}
        <a class="rr-tile" href="{{ c.url }}">
          <span class="rr-tile__imgwrap">
            {%- if img -%}
              <img src="{{ img | image_url: width: 640 }}"
                   srcset="{{ img | image_url: width: 400 }} 400w, {{ img | image_url: width: 640 }} 640w"
                   sizes="(max-width: 640px) 45vw, 300px"
                   alt="{{ c.title | escape }}" loading="lazy" width="640" height="820">
            {%- endif -%}
          </span>
          <span class="rr-tile__band">
            <span class="rr-tile__name">{{ c.title | remove: " Collection" | upcase }}</span>
            <span class="rr-tile__count">{{ c.products.size }} design{% if c.products.size != 1 %}s{% endif %} →</span>
          </span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<style>
  .rr-ranges{padding:clamp(36px,6vw,80px) clamp(16px,4vw,56px);background:#FFFFFF;color:#231F1D}
  .rr-ranges__head{text-align:center;max-width:640px;margin:0 auto clamp(28px,4vw,48px)}
  .rr-ranges__kicker{font-size:.78rem;letter-spacing:.22em;text-transform:uppercase;color:#8A7B6E;margin:0 0 10px}
  .rr-ranges__title{font-size:clamp(1.7rem,4.5vw,2.8rem);font-weight:800;letter-spacing:.04em;margin:0;color:#2B211C}
  .rr-ranges__title::after{content:"";display:block;width:64px;height:3px;background:#2B211C;margin:14px auto 0}
  .rr-ranges__sub{color:#6E5F58;margin:14px 0 0;font-size:.95rem}
  .rr-ranges__grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:clamp(12px,2vw,22px);max-width:1280px;margin:0 auto}
  @media(max-width:640px){.rr-ranges__grid{grid-template-columns:repeat(2,1fr)}}
  .rr-tile{display:block;text-decoration:none;color:inherit;background:#FAF8F5;border:1px solid #EAE4DC;transition:box-shadow .25s,transform .25s}
  .rr-tile:hover{box-shadow:0 16px 36px rgba(43,33,28,.16);transform:translateY(-3px)}
  .rr-tile__imgwrap{display:block;aspect-ratio:4/5;overflow:hidden;background:#F1EDE7}
  .rr-tile__imgwrap img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .4s}
  .rr-tile:hover .rr-tile__imgwrap img{transform:scale(1.04)}
  .rr-tile__band{display:flex;flex-direction:column;gap:2px;padding:12px 14px;background:#2B211C;color:#F5F1EB}
  .rr-tile__name{font-weight:700;letter-spacing:.12em;font-size:.82rem}
  .rr-tile__count{font-size:.72rem;color:#C9BBAC}
</style>

{% schema %}
{
  "name": "Shop by collection",
  "tag": "section",
  "class": "section-shop-by-collection",
  "presets": [
    {
      "name": "Shop by collection"
    }
  ]
}
{% endschema %}
