{
  "name": "bookkeeping",
  "version": "1.0.0",
  "private": true,
  "description": "Local bookkeeping app for a single company",
  "type": "module",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "start": "concurrently -n server,client -c blue,green \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "npm run dev --workspace client",
    "seed": "node server/seed.js",
    "build": "npm run build --workspace client"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "cors": "^2.8.5",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
